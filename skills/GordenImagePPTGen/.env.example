# GordenImagePPTGen — GPT Image API Configuration
# Copy this file to .env and fill in your API credentials.

# ── GPT Image 2 API ──────────────────────────────────────────────
# Required: your OpenAI-compatible API key
GPT_IMAGE_API_KEY=your-api-key-here

# Required: base URL for the API endpoint (without /images/generations suffix)
GPT_IMAGE_API_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-image-2)
GPT_IMAGE_MODEL=gpt-image-2

# Optional: image size (default: 1920x1080 for 16:9)
GPT_IMAGE_SIZE=1920x1080

# Optional: request timeout in seconds (default: 300)
GPT_IMAGE_TIMEOUT=300

# Optional: max retries on transient errors (default: 3)
GPT_IMAGE_MAX_RETRIES=3
